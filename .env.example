# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Core (no external service required) ---
CIB_DB_PATH=data/cib.sqlite3
# Identity recorded in created_by / logged_by on every write. Defaults to the OS user.
CIB_ACTOR=

# --- Optional API-based ingestion ---
# GDELT DOC 2.0 requires no key.
GDELT_ENABLED=0
# Media Cloud: https://search.mediacloud.org/  (Account -> API token)
MEDIACLOUD_API_KEY=

# --- Optional LLM fallback for ambiguous entity-role classification ---
# Off by default. Rule-based matching is always tried first.
CIB_LLM_ROLES_ENABLED=0
ANTHROPIC_API_KEY=

# --- Optional alerting for watch-rule hits ---
# Channels: stdout | file | webhook | email  (comma-separated, first-to-last)
CIB_NOTIFY_CHANNELS=stdout
CIB_NOTIFY_WEBHOOK_URL=
CIB_NOTIFY_FILE=data/alerts.log
CIB_SMTP_HOST=
CIB_SMTP_PORT=587
CIB_SMTP_USER=
CIB_SMTP_PASSWORD=
CIB_NOTIFY_EMAIL_FROM=
CIB_NOTIFY_EMAIL_TO=

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# Origins the API accepts browser requests from. Leave blank to allow any loopback origin,
# which is what a local-first tool wants. Set it explicitly to pin the dashboard down.
CIB_CORS_ORIGINS=
